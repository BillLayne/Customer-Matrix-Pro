{
  "name": "customer-matrix-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "deploy": "npm run check && wrangler pages deploy dist --project-name customer-matrix-pro --branch main",
    "secrets:check": "node scripts/check-staged-secrets.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^6.2.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
